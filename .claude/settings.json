{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/checks-before-commit.sh",
            "timeout": 300,
            "statusMessage": "Typecheck, lint and tests before committing"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/story-before-commit.sh",
            "statusMessage": "A story for changes to the game"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/review-before-push.sh",
            "timeout": 600,
            "statusMessage": "A second model reviews the push against CLAUDE.md"
          }
        ]
      },
      {
        "matcher": "Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/compiler-gate.sh",
            "statusMessage": "Compiler first"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/checks-before-stop.sh",
            "timeout": 300,
            "statusMessage": "Checking changed code before stopping"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/compiled.sh"
          }
        ]
      }
    ]
  }
}
